# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Use READ-ONLY AWS credentials — this tool never modifies cloud resources.
# Recommended IAM policies: SecurityAudit + ViewOnlyAccess (AWS managed).

# --- AWS (read-only) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Region to scan. AWS_REGION takes precedence; AWS_DEFAULT_REGION is a fallback.
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1

# --- Ollama (local LLM, OpenAI-compatible API) ---
# From the host use http://localhost:11434/v1. Under docker compose the web
# service overrides this to http://ollama:11434/v1 (the compose network), so you
# normally don't need to set it here.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# --- Docker compose: host path for Prowler scan output ---
# The web container launches Prowler on the HOST Docker daemon, so Prowler's
# bind-mount SOURCE must be a path the HOST understands (NOT the container's
# /app/scans). Set this to the ABSOLUTE host path of this project's ./scans dir.
# On Linux/macOS the compose default "${PWD}/scans" usually works and you can
# leave this unset. On Windows/Docker Desktop, set it explicitly, e.g.:
#   HOST_SCANS_DIR=C:\Users\you\Desktop\CSPM_analyzer\scans
# (only used when you actually run a scan).
HOST_SCANS_DIR=

# --- Persistence (SQLite) ---
# Directory holding the SQLite database file (cspm.db). Under docker compose this
# is /app/data (backed by the ./data volume). For local non-Docker dev, leave it
# unset to default to ./data in the project root.
DATA_DIR=
